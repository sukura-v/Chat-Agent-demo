# ── DeepSeek LLM (required) ────────────────────────────────────────────
# https://platform.deepseek.com — create an API key and paste it here.
API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── JWT (demo session signing) ─────────────────────────────────────────
# Falls back to API_KEY when unset. Use a strong random value in production.
JWT_SECRET=

# ── CORS ────────────────────────────────────────────────────────────────
# Vite dev server origins; loopback addresses of any port are always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Misc ────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
