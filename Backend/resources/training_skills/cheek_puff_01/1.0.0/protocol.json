{
  "exercise_id": "cheek_puff_01",
  "display_name": "鼓腮训练",
  "icon": "🐡",
  "description": "基于 MediaPipe Face Landmarker 的鼓腮外观、闭唇保持与下颌代偿观察。",
  "$schema": "https://oral-rehab.ai/schemas/training_protocol_v2.json",
  "schema_version": "2.0",
  "calibration_policy": {
    "target_valid_frames": 30,
    "max_observed_frames": 600,
    "min_valid_ratio": 0.45,
    "min_face_width_ratio": 0.05,
    "max_face_width_ratio": 0.95,
    "max_normalized_jaw_std": 0.09,
    "min_head_pose_stable_ratio": 0.4,
    "max_retries": 5
  },
  "calibration_guidance": {
    "warmup_ms": 150,
    "max_alignment_ms": 45000,
    "ready_hold_ms": 120,
    "capture_break_grace_ms": 1500,
    "preferred_interocular_ratio": [0.10, 0.48],
    "preferred_face_center": [0.5, 0.44],
    "max_center_offset": [0.30, 0.32],
    "voice_prompt_cooldown_ms": 3500
  },
  "execution_tracking_policy": {
    "soft_scale_ratio": [0.55, 1.60],
    "hard_scale_ratio": [0.40, 1.90],
    "soft_center_offset": [0.26, 0.28],
    "hard_center_offset": [0.30, 0.32],
    "warning_hold_ms": 250,
    "block_grace_ms": 400,
    "continuity_reset_after_ms": 400,
    "reacquire_hold_ms": 500,
    "max_blocked_ms": 5000,
    "wall_timeout_multiplier": 2
  },
  "total_steps": 3,
  "jaw_compensation_threshold": 0.012,
  "steps": [
    {
      "step_index": 0,
      "step_id": "lip_closure_ready",
      "completion_mode": "scored",
      "title": "闭唇准备",
      "instruction_text": "轻轻闭上嘴唇，保持自然呼吸。",
      "instruction_audio": "轻轻闭上嘴唇，保持自然呼吸。",
      "validation_rules": [
        {
          "dimension_ref": "lip_closure_visual_proxy",
          "source_features": ["metric.lip_seal_score"],
          "score_model": { "type": "higher_is_better", "min": 0, "target": 0.85 },
          "aggregation_ref": { "method": "median" },
          "quality_requirements": { "min_coverage_ratio": 0.5, "min_fps": 15, "require_stable_head_pose": true },
          "metric": "lip_seal_score",
          "condition": ">",
          "threshold": 0.75,
          "weight": 0.7,
          "penalty_role": "objective",
          "failure_hint": "嘴唇轻轻闭住，不要漏气。"
        },
        {
          "dimension_ref": "jaw_stability_visual_proxy",
          "source_features": ["metric.jaw_vertical_variance"],
          "score_model": { "type": "lower_is_better", "target": 0.006, "max": 0.02 },
          "aggregation_ref": { "method": "median" },
          "quality_requirements": { "min_coverage_ratio": 0.5, "min_fps": 15, "require_stable_head_pose": true },
          "metric": "jaw_vertical_variance",
          "condition": "<",
          "threshold": 0.012,
          "weight": 0.3,
          "penalty_role": "penalty",
          "failure_hint": "下颌保持安静，不要上下晃。"
        }
      ],
      "pass_criteria": { "min_score": 65, "sustain_ms": 800 },
      "attempt_policy": { "timeout_ms": 6000, "max_attempts": 3 },
      "duration_hint_seconds": 4
    },
    {
      "step_index": 1,
      "step_id": "cheek_puff_form",
      "completion_mode": "scored",
      "title": "鼓起双腮",
      "instruction_text": "把空气含在口腔里，让两侧脸颊鼓起来。",
      "instruction_audio": "把空气含在口腔里，让两侧脸颊鼓起来。",
      "validation_rules": [
        {
          "dimension_ref": "cheek_puff_visual_proxy",
          "source_features": ["metric.cheek_bulge_ratio", "blendshape.cheekPuff"],
          "score_model": { "type": "higher_is_better", "min": 1, "target": 1.08 },
          "aggregation_ref": { "method": "p95" },
          "quality_requirements": { "min_coverage_ratio": 0.5, "min_fps": 15, "require_stable_head_pose": true },
          "metric": "cheek_bulge_ratio",
          "condition": ">",
          "threshold": 1.04,
          "weight": 0.7,
          "penalty_role": "objective",
          "failure_hint": "脸颊再鼓一点，但不要用下巴帮忙。"
        },
        {
          "dimension_ref": "lip_closure_visual_proxy",
          "source_features": ["metric.lip_seal_score"],
          "score_model": { "type": "higher_is_better", "min": 0, "target": 0.85 },
          "aggregation_ref": { "method": "median" },
          "quality_requirements": { "min_coverage_ratio": 0.5, "min_fps": 15, "require_stable_head_pose": true },
          "metric": "lip_seal_score",
          "condition": ">",
          "threshold": 0.75,
          "weight": 0.3,
          "penalty_role": "objective",
          "failure_hint": "嘴唇保持闭合，像把小气球封住。"
        }
      ],
      "pass_criteria": { "min_score": 70, "sustain_ms": 1000 },
      "attempt_policy": { "timeout_ms": 8000, "max_attempts": 3 },
      "duration_hint_seconds": 6
    },
    {
      "step_index": 2,
      "step_id": "cheek_puff_hold",
      "completion_mode": "scored",
      "title": "稳定保持",
      "instruction_text": "保持鼓腮 5 秒，头部和下颌稳定。",
      "instruction_audio": "保持鼓腮五秒，头部和下颌稳定。",
      "validation_rules": [
        {
          "dimension_ref": "cheek_puff_visual_proxy",
          "source_features": ["metric.cheek_bulge_ratio", "blendshape.cheekPuff"],
          "score_model": { "type": "higher_is_better", "min": 1, "target": 1.08 },
          "aggregation_ref": { "method": "p95" },
          "quality_requirements": { "min_coverage_ratio": 0.5, "min_fps": 15, "require_stable_head_pose": true },
          "metric": "cheek_bulge_ratio",
          "condition": ">",
          "threshold": 1.04,
          "weight": 0.5,
          "penalty_role": "objective",
          "failure_hint": "继续保持鼓腮，不要漏气。"
        },
        {
          "dimension_ref": "jaw_stability_visual_proxy",
          "source_features": ["metric.jaw_vertical_variance"],
          "score_model": { "type": "lower_is_better", "target": 0.006, "max": 0.02 },
          "aggregation_ref": { "method": "median" },
          "quality_requirements": { "min_coverage_ratio": 0.5, "min_fps": 15, "require_stable_head_pose": true },
          "metric": "jaw_vertical_variance",
          "condition": "<",
          "threshold": 0.012,
          "weight": 0.5,
          "penalty_role": "penalty",
          "failure_hint": "下颌稳定，避免代偿。"
        }
      ],
      "pass_criteria": { "min_score": 70, "sustain_ms": 5000 },
      "attempt_policy": { "timeout_ms": 12000, "max_attempts": 3 },
      "duration_hint_seconds": 7
    }
  ],
  "completion_message": "鼓腮训练完成！本结果是视觉代理训练反馈，不测口内压力。",
  "completion_report_fields": ["steps_completed", "avg_score", "duration_seconds"]
}
