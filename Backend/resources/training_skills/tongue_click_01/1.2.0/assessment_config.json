{
  "$schema": "https://oral-rehab.ai/schemas/assessment_config_v2.json",
  "schema_version": "2.1",
  "skill_id": "tongue_click_01",
  "clinical_protocol_reference": "OMES/OMES-E",
  "runtime_perception_engine": "MediaPipe Face Landmarker + Web Audio",
  "assessment_mode": "OMES-domain multimodal training proxy",
  "clinical_validity": "not_diagnostic_not_gold_standard",
  "feature_schema_version": "1",
  "scoring_model_version": "tongue-click-rf@0.1.0",
