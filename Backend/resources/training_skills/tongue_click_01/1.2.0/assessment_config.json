  "attempt_assessment": {
    "required_dimensions": ["jaw_stability_visual_proxy", "lip_lateral_control_visual_proxy", "tongue_click_validity_acoustic_proxy", "tongue_click_acoustic_rhythm", "tongue_click_endurance_acoustic_proxy"],
    "weights": {
      "jaw_stability_visual_proxy": 0.25,
      "lip_lateral_control_visual_proxy": 0.15,
      "tongue_click_validity_acoustic_proxy": 0.25,
      "tongue_click_acoustic_rhythm": 0.25,
      "tongue_click_endurance_acoustic_proxy": 0.1
    }
  },
  "unsupported_domains": ["muscle_tone", "tongue_strength", "palatal_elevation", "velopharyngeal_closure", "tongue_tip_contact", "swallowing_safety"],
  "disclaimer": "MediaPipe and microphone output are OMES-domain multimodal training proxies, not a formal OMES/OMES-E clinical score or diagnosis."
